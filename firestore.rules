rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isEmailVerified() && request.auth.token.email == 'gestsocialgabriele@gmail.com';
    }

    function isOwner(userId) {
      return isEmailVerified() && request.auth.uid == userId;
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'lastLogin', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'lastLogin', 'createdAt']) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.email is string && data.email.size() <= 320 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.lastLogin is string && data.lastLogin.size() >= 1 && data.lastLogin.size() <= 64 &&
        data.createdAt is string && data.createdAt.size() >= 1 && data.createdAt.size() <= 64;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) && isValidUser(incoming(), userId);
      allow update: if isValidId(userId) && isValidUser(incoming(), userId) && (
        isAdmin() ||
        (
          isOwner(userId) &&
          incoming().uid == existing().uid &&
          (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'lastLogin'])
        )
      );
      allow delete: if false;
    }
  }
}
