# API key for Gemini (Set in Vercel Environment Variables)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Secret for session tokens (Set in Vercel Environment Variables)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="YOUR_AUTH_SECRET"
# Users (JSON array of {id, name, hash, role})
USERS='[{"id":"admin","name":"Administrator","hash":"scrypt$saltB64$hashB64","role":"admin"}]'
# Server port
PORT=3000
# Upstash Redis / Vercel KV REST configuration (REQUIRED to modify access, passwords, and users from the app on Vercel)
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
# Force env users mode (set to true to restore env users priority over KV in case of recovery/lockout)
# FORCE_ENV_USERS="false"
# INVITE_CODE=""
# RESEND_API_KEY=""
# MAIL_FROM=""
# APP_URL=""
