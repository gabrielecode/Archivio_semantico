# API key for Gemini (Set in Vercel Environment Variables)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Secret for session tokens (Set in Vercel Environment Variables)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="YOUR_AUTH_SECRET"
# Users (JSON array of {id, name, hash})
USERS='[{"id":"admin","name":"Administrator","hash":"scrypt$saltB64$hashB64"}]'
# Server port
PORT=3000
