{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated user profile stored in Firestore",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address",
          "maxLength": 320
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "maxLength": 120
        },
        "lastLogin": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of the latest sign-in",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of account creation",
          "maxLength": 64
        }
      },
      "required": ["uid", "email", "displayName", "lastLogin", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile documents keyed by Firebase Auth UID"
    }
  }
}
